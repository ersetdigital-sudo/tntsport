# ============================================================================
# TNT Sport Apparel — contoh environment variable untuk development lokal
# ============================================================================
# Salin file ini jadi .env.local lalu isi nilainya:
#   cp .env.local.example .env.local
#
# JANGAN pernah menaruh nilai asli di file ini — file ini ikut ter-commit.
# Nilai production diatur di Vercel → Project Settings → Environment Variables.
#
# Daftar nama di bawah diambil dari seluruh `process.env.*` yang benar-benar
# dipakai di app/, components/, lib/, dan middleware.ts.
# ============================================================================

# ── Supabase (wajib) ────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Hanya untuk server (endpoint notifikasi). Jangan pernah dipakai di client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Secret internal (wajib) ─────────────────────────────────────────────────
# Kunci enkripsi token Fonnte di tabel app_settings (AES-256-GCM).
# Ganti kalau berubah: token yang sudah tersimpan harus diisi ulang.
SETTINGS_ENCRYPTION_KEY=generate-random-32-byte-string
# Penanda tangan token tracking customer (HMAC).
TRACK_SESSION_SECRET=generate-random-string
# Password dashboard Pesanan (/pesanan/orders, /pesanan/maklon).
PESANAN_PASSWORD=choose-a-dashboard-password
# Proteksi endpoint pengingat deadline (?secret=... atau header x-cron-secret).
CRON_SECRET=generate-random-string

# ── Cloudinary (upload foto design & WO) ────────────────────────────────────
# Pakai unsigned upload preset.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
# Fallback untuk upload dari sisi client.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# ── Meta Conversions API (opsional) ─────────────────────────────────────────
# Kalau kosong, event server-side dilewati dan Meta Pixel di browser tetap jalan.
META_CAPI_ACCESS_TOKEN=your-meta-capi-access-token
